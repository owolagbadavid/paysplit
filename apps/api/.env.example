# Local development works with these values as they are, against docker compose and the provider emulators.
# To use the real sandboxes, change the payment and DOJAH_* blocks and run `pnpm sandbox:check`.

APP_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5544/paysplit

# Supabase Auth. Locally this is the GoTrue container, and the key below only works there.
# Hosted: https://<project>.supabase.co/auth/v1 and the service_role key.
SUPABASE_AUTH_URL=http://localhost:9999
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoicGF5c3BsaXQtbG9jYWwiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6NDEwMjQ0NDgwMH0._nd0fYdabp5aayq9cbkOzrme0LXQwB9MTdXymxpKVBk

# Generate your own outside local development: openssl rand -base64 32
DATA_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWxvbmc=
FINGERPRINT_KEY=local-dev-only-fingerprint-key-0123456789
CRON_SECRET=local-dev-cron-secret

# Real sandbox: PAYMENT_PROVIDER=flutterwave with FLUTTERWAVE_SECRET_KEY and FLUTTERWAVE_WEBHOOK_HASH (32+ characters),
# or keep paystack with your sk_test_ key and remove PAYSTACK_BASE_URL.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_emulator
PAYSTACK_BASE_URL=http://localhost:4010/paystack

# Real sandbox: your app ID and key, and remove DOJAH_BASE_URL.
DOJAH_APP_ID=emulator
DOJAH_SECRET_KEY=emulator
DOJAH_BASE_URL=http://localhost:4010/dojah

# Mail lands in Mailpit at http://localhost:8026. Hosted: a Mailgun SMTP_URL (see docs/DEPLOY.md), or BREVO_API_KEY.
EMAIL_FROM=PaySplit <no-reply@paysplit.local>
SMTP_URL=smtp://localhost:1026
BREVO_API_KEY=

SENTRY_DSN=
